
# Embody / Envoy -- normalize TD line endings (auto-managed)
*.py text eol=lf
*.md text eol=lf
*.tdn text eol=lf diff=tdn
*.json text eol=lf
*.tsv text eol=lf
*.xml text eol=lf
*.toe binary
*.tox binary

# Web app source -- normalize to LF (matches Prettier output, avoids autocrlf churn)
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yaml text eol=lf
