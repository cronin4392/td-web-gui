
# Embody / Envoy -- normalize TD line endings (auto-managed)
*.py text eol=lf
*.md text eol=lf
*.tdn text eol=lf diff=tdn
*.json text eol=lf
*.tsv text eol=lf
*.xml text eol=lf
*.toe binary
*.tox binary

# Web app source -- normalize to LF (matches Prettier output, avoids autocrlf churn)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yaml text eol=lf

# Catalog snapshots -- `core.autocrlf` would otherwise check these out as CRLF
# while `db:export` writes LF, so every export would rewrite all three in full.
*.sql text eol=lf

# SQLite catalogs -- tracked, and never to be touched as text. `core.autocrlf`
# is on here, so this is what stops a stray CRLF rewrite corrupting the file.
# `merge=binary` makes a conflict stop cleanly rather than splice two databases
# into rubble; resolve one by picking a side and re-running the sync.
*.db binary merge=binary
