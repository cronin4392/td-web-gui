{
  "name": "td-web-gui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write . && pnpm format:py",
    "format:check": "prettier --check . && pnpm format:py:check",
    "format:py": "ruff format .",
    "format:py:check": "ruff format --check .",
    "db:checkpoint": "node scripts/checkpoint-sqlite.mjs apps/vj-gui/data/scenes.db apps/vj-gui/data/effects.db apps/vj-gui/data/wordbank.db",
    "db:export": "node scripts/db-export.mjs apps/vj-gui/data/scenes.db apps/vj-gui/data/effects.db apps/vj-gui/data/wordbank.db",
    "db:import": "node scripts/db-import.mjs apps/vj-gui/data/scenes.db apps/vj-gui/data/effects.db apps/vj-gui/data/wordbank.db",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,mjs,jsx,ts,tsx,json,css,md,yml,yaml}": "prettier --write",
    "*.py": "ruff format"
  },
  "devDependencies": {
    "husky": "^8.0.0",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3"
  }
}
