{
  "name": "td-web-gui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write . && pnpm format:py",
    "format:check": "prettier --check . && pnpm format:py:check",
    "format:py": "ruff format .",
    "format:py:check": "ruff format --check .",
    "prepare": "husky install"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "husky": "^8.0.0"
  }
}
