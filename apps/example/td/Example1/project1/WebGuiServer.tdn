source_file: Example.toe
exported_at: '2026-07-31T03:45:46Z'
network_path: /project1/WebGuiServer
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  textDAT:
    parameters:
      syncfile: true
    flags:
    - viewer
    color: [0.67, 0.67, 0.67]
  fitTOP:
    parameters:
      outputresolution: limit
      resolutionw: 480
      resolutionh: 480
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    tags:
    - webgui-generated
    - webgui-stream
  flipTOP:
    parameters:
      flipx: true
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    tags:
    - webgui-generated
    - webgui-stream
  datexecuteDAT:
    parameters:
      fromop: =parent()
      execute: end
      syncfile: true
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  selectTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    tags:
    - webgui-generated
    - webgui-stream
  videostreamoutTOP:
    parameters:
      mode: webrtc
      fps: 15
      webrtc: webrtc1
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    tags:
    - webgui-generated
    - webgui-stream
  parameterexecuteDAT:
    parameters:
      fromop: =parent()
      file: =parent.WebGuiServer.par.Tdcoredir.eval() + '/parameter-execute.py'
      syncfile: true
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    tags:
    - webgui-generated
  chopexecuteDAT:
    parameters:
      fromop: =parent()
      file: =parent.WebGuiServer.par.Tdcoredir.eval() + '/chop-execute.py'
      syncfile: true
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    tags:
    - webgui-generated
type: baseCOMP
custom_pars:
  Web GUI:
  - name: Port
    style: Int
    default: 9980
    min: 1.0
    max: 65535.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 65535.0
  - name: Configfile
    style: File
    label: Config File
    value: config.py
  - name: Identifier
    style: Str
    value: example1
  - name: Tdcoredir
    style: Folder
    label: TD Core Dir
    startSection: true
    default: C:/Users/croni/Projects/Sites/td-web-gui/packages/td-core/touchdesigner
    help: Absolute path to packages/td-core/touchdesigner on this machine's checkout. The webserver-callbacks / webrtc-callbacks / parameter-execute DATs sync against files inside this folder -- set it once per machine so those file params don't depend on how many folders deep this .toe happens to live relative to the package.
    value: =project.folder + '/../../../../packages/td-core/touchdesigner'
