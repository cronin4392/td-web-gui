format: tdn
version: '2.0'
build: 3
generator: Embody/6.0.154
td_build: 099.2025.33070
source_file: Example.toe
exported_at: '2026-07-27T16:28:50Z'
network_path: /project1/WebGuiServer
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  textDAT:
    parameters:
      syncfile: true
      language: python
    flags:
    - viewer
    color: [0.67, 0.67, 0.67]
  parameterexecuteDAT:
    parameters:
      fromop: =parent()
      file: =op.WebGuiServer.par.Tdcoredir.eval() + '/parameter-execute.py'
      syncfile: true
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    tags:
    - webgui-generated
  datexecuteDAT:
    parameters:
      fromop: =parent()
      execute: end
      file: =op.WebGuiServer.par.Tdcoredir.eval() + '/dat-execute.py'
      syncfile: true
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    tags:
    - webgui-generated
  chopexecuteDAT:
    parameters:
      fromop: =parent()
      file: =op.WebGuiServer.par.Tdcoredir.eval() + '/chop-execute.py'
      syncfile: true
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    tags:
    - webgui-generated
type: baseCOMP
custom_pars:
  Web GUI:
  - name: Port
    style: Int
    default: 9980
    min: 1.0
    max: 65535.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 65535.0
  - name: Configfile
    style: File
    label: Config File
    value: config.py
  - name: Identifier
    style: Str
    value: example1
  - name: Tdcoredir
    style: Folder
    label: TD Core Dir
    startSection: true
    default: C:/Users/croni/Projects/Sites/td-web-gui/packages/td-core/touchdesigner
    help: Absolute path to packages/td-core/touchdesigner on this machine's checkout. The webserver-callbacks / webrtc-callbacks / parameter-execute DATs sync against files inside this folder -- set it once per machine so those file params don't depend on how many folders deep this .toe happens to live relative to the package.
parameters:
  parentshortcut: WebGuiServer
  opshortcut: WebGuiServer
sequences:
  ext:
  - object: me.op('WebGuiServerExt').module.WebGuiServerExt(me)
    name: WebGuiServerExt
    promote: true
color: [0.3, 0.5, 0.9]
tags:
- tdn
operators:
- name: config
  type: textDAT
  parameters:
    file: ~parent.WebGuiServer.par.Configfile
    extension: py
  position: [-650, 225]
  size: [130, 90]
- name: webrtc1
  type: webrtcDAT
  parameters:
    active: true
    callbacks: webrtc1_callbacks
  flags:
  - viewer
  position: [-300, 225]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: webserver1
  type: webserverDAT
  parameters:
    active: true
    port: ~parent.WebGuiServer.par.Port
    localaddress: 127.0.0.1
    callbacks: webserver1_callbacks
  flags:
  - viewer
  position: [-475, 225]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: WebGuiServerExt
  type: textDAT
  parameters:
    file: =op.WebGuiServer.par.Tdcoredir.eval() + '/webgui-server-ext.py'
  position: [-642, 400]
  size: [463, 317]
- name: webrtc1_callbacks
  type: textDAT
  parameters:
    file: =op.WebGuiServer.par.Tdcoredir.eval() + '/webrtc-callbacks.py'
  position: [-300, 100]
  size: [130, 90]
  dock: webrtc1
