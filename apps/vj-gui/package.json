    "td-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-node": "^3.2.4",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.0.0"
  }
}
