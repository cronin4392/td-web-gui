{
  "name": "vj-gui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:scenes": "vite-node server/catalog/sync-scenes.ts",
