# Copy to .env and point these at your TouchDesigner content folders.
# Read by the dev/preview server and the `pnpm db:*` sync scripts only —
# neither path reaches the browser.

VJ_SCENES_ROOT=C:/Users/you/Projects/Touchdesigner/Touchdesigner-VJ-v2/Scenes-35280
VJ_EFFECTS_ROOT=C:/Users/you/Projects/Touchdesigner/Touchdesigner-VJ-v2/Effects-35280

# Optional — where the synced catalogs are written.
# Default: apps/vj-gui/data/{scenes,effects}.db
# VJ_SCENES_DB=
# VJ_EFFECTS_DB=
