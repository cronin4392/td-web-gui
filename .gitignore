.claude

# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo
__pycache__

# Vite
.vite/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Env overrides
.env
.env.local
.env.*.local

# SQLite catalogs. The live databases are untracked: the app rewrites them as you
# work, so tracking them left `git status` unable to tell an edit from a
# background write, and made every stash, checkout and branch switch a fight with
# a moving — often reader-locked — binary. `pnpm db:export` writes the snapshot
# under `apps/vj-gui/data/snapshots/`, and that text is what is tracked instead.
apps/vj-gui/data/*.db
*.db-shm
*.db-wal
*.importing

# Embody / Envoy (auto-managed)
Backup/
logs/
CrashAutoSave*
.venv/
.mcp.json
opencode.json
.tdn_backup/
**/.embody/*
!**/.embody/project.json
.claude/settings.local.json
.claude/projects/
briefs/
__pycache__/
